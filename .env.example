# Copia este archivo a .env y completa los valores.

# String largo random (cualquier texto sirve).
SESSION_SECRET=

# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si la pierdes, hay que reconectar todas las cuentas de Zoho de nuevo.
MASTER_KEY=

# Usuario admin del panel (texto plano).
ADMIN_USER=

# Corre `npm run hash-password` y pega aca la linea que te devuelve.
ADMIN_PASSWORD_HASH=

# URL publica final del panel (la que le vas a poner en EasyPanel).
PUBLIC_BASE_URL=

# Puerto interno (opcional, default 3000).
PORT=3000

# Poner en 1 en EasyPanel (o cualquier proxy) para que la cookie de sesion
# funcione bien detras de HTTPS terminado en el proxy.
TRUST_PROXY=1
